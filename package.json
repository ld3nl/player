{
  "name": "audiofeature",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "type-check": "tsc --noEmit --incremental false && tsc --project tooling/tsconfig.json --noEmit --incremental false",
    "check": "bun run lint && bun run lint:design && bun run test:design && bun run knip && bun run type-check",
    "eslint-lint": "eslint --fix --ext .ts,.tsx,.js,.jsx 'components/**/*' 'lib/**/*' 'pages/**/*'",
    "format": "biome format --write .",
    "lint:design": "bun run tooling/design/check.ts",
    "test:design": "bun test tooling/design"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@headlessui/react": "^2.2.10",
    "@phosphor-icons/react": "2.1.10",
    "axios": "^1.21.0",
    "cnfast": "^0.2.0",
    "he": "^2.0.0",
    "lodash": "^4.18.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-player": "^3.4.0",
    "react-slider": "^2.0.6"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/he": "^1.2.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-slider": "^1.3.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "knip": "6.44.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
